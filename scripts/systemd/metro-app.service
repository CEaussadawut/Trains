# User service for the app itself.
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/*.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now metro-app metro-tunnel
#
# To survive logout/reboot you also need linger (this one does need sudo):
#   sudo loginctl enable-linger $USER
[Unit]
Description=Bangkok Metro Search visualizer
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/Trains
ExecStart=/usr/bin/python3 -m server --dist web/dist --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
